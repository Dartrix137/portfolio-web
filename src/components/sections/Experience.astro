---
import Section from "@/components/Section.astro";
import { work } from "@cv";
import { work as workEn } from "@cv-en";

const monthsEs = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dec"];
const monthsEn = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
---

<Section titleEs="Experiencia" titleEn="Experience">
    <ul>
        {
            work.map((job, i) => {
                const jobEn = workEn[i];

                const startYear = new Date(job.startDate).getFullYear();
                const startMonth = new Date(job.startDate).getMonth();
                const hasEnd = job.endDate != null && job.endDate !== "";
                const endYear = hasEnd ? new Date(job.endDate).getFullYear() : null;
                const endMonth = hasEnd ? new Date(job.endDate).getMonth() : null;

                const yearsEs = hasEnd
                    ? `${monthsEs[startMonth]} ${startYear} - ${monthsEs[endMonth!]} ${endYear}`
                    : `${monthsEs[startMonth]} ${startYear} - Actual`;
                const yearsEn = hasEnd
                    ? `${monthsEn[startMonth]} ${startYear} - ${monthsEn[endMonth!]} ${endYear}`
                    : `${monthsEn[startMonth]} ${startYear} - Present`;

                return (
                    <li>
                        <article>
                            <header>
                                <div>
                                    <h3>
                                        <a href={job.url} title={`View ${job.name}`} target="_blank">
                                            {job.name}
                                        </a>
                                    </h3>
                                    <h4>
                                        <span class="lang lang-es">{job.position}</span>
                                        <span class="lang lang-en">{jobEn.position}</span>
                                    </h4>
                                </div>
                                <time>
                                    <span class="lang lang-es">{yearsEs}</span>
                                    <span class="lang lang-en">{yearsEn}</span>
                                </time>
                            </header>
                            <footer>
                                <p class="lang lang-es">{job.summary}</p>
                                <p class="lang lang-en">{jobEn.summary}</p>
                            </footer>
                        </article>
                    </li>
                );
            })
        }
    </ul>
</Section>

<style>
    p {
        text-align: justify;
    }
    ul {
        display: flex;
        flex-direction: column;
        gap: 32px;
    }

    article h3 {
        font-weight: 600;
        font-size: 1.2rem;
    }

    article a {
        color: #e7e7e7;
    }

    article a:hover {
        text-decoration: underline;
    }

    article h4 {
        font-weight: 500;
        font-size: 1.1rem;
    }

    header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 4px;
    }

    time {
        font-size: 0.95rem;
        min-width: 102px;
    }

    @media (width <= 700px) {
        time {
            text-align: right;
        }
    }
</style>
