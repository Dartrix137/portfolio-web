---
const { titleEs, titleEn } = Astro.props
---

<section>
    {(titleEs || titleEn) && (
        <h2>
            {titleEs && <span class="lang lang-es">{titleEs}</span>}
            {titleEn && <span class="lang lang-en">{titleEn}</span>}
        </h2>
    )}
    <slot/>
</section>

<style>
    section {
        max-width: 700px;
        margin: 0 auto 72px;
    }

    h2{
        margin-bottom: 8px;
        font-weight: 700;
        line-height: 1.5;
        font-size: 1.6rem;
    }
</style>
